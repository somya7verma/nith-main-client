// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?
  FacultyRole FacultyRole[]
}

model RolePosition {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(100)
  priority    Int?
  FacultyRole FacultyRole[]
}

model Faculty {
  id          Int          @id @default(autoincrement())
  from_ce     String?      @db.VarChar(100)
  website     String?      @db.VarChar(255)
  FacultyRole FacultyRole[]
}

model FacultyRole {
  id          Int          @id @default(autoincrement())
  faculty_id  Int
  position_id Int
  category_id Int
  start_date  DateTime?    @db.Date
  end_date    DateTime?    @db.Date
  is_active   Boolean?

  faculty     Faculty      @relation(fields: [faculty_id], references: [id])
  position    RolePosition @relation(fields: [position_id], references: [id])
  category    Category     @relation(fields: [category_id], references: [id])
}

model Homepage {
  id                     Int      @id @default(autoincrement())
  HeroMain               String   @db.VarChar(255)
  HeroSub                String   @db.VarChar(255)
  HeroDesc               String   @db.VarChar(500)
  HeroBtnText            String   @db.VarChar(100)
  HeroBtnLink            String   @db.VarChar(255)
  Heroanchor             String   @db.VarChar(100)

  AboutHead              String   @db.VarChar(255)
  AboutDesc              String   @db.VarChar(1000)
  AboutMission           String   @db.VarChar(500)
  AboutVision            String   @db.VarChar(500)

  AcademicYear           String   @db.VarChar(50)
  Academicplacement      String   @db.VarChar(255)
  AcademicHighpackage    String   @db.VarChar(100)
  AcademicAverage        String   @db.VarChar(100)
  AcademicToprecruiters  String   @db.VarChar(500)

  DirectorName           String   @db.VarChar(255)
  DirectorMessage        String   @db.VarChar(1000)
  DirectorDesignation    String   @db.VarChar(255)
  Directoremail          String   @db.VarChar(255)
  Directorphone          String   @db.VarChar(50)

  createdAt              DateTime @default(now()) @db.Timestamp(6)
  updatedAt              DateTime @updatedAt     @db.Timestamp(6)
}

model Events{
  id        Int      @id @default(autoincrement())
  Heading   String   @db.VarChar(255)
  Subheading String  @db.VarChar(255)
  Description String @db.VarChar(500)
  image     String   @db.Text
  startedAt DateTime @db.Date
  endedAt   DateTime @db.Date

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt     @db.Timestamp(6)
}

model News{
  id         Int      @id @default(autoincrement())
  Heading    String   @db.VarChar(255)
  Subheading String   @db.VarChar(255)
  Description String  @db.VarChar(500)
  image      String   @db.Text
  startedAt  DateTime @db.Date
  endedAt    DateTime @db.Date

  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @updatedAt     @db.Timestamp(6)
}

model Achievements{
  id          Int      @id @default(autoincrement())
  tagline     String   @db.VarChar(255)
  Heading     String   @db.VarChar(255)
  description String   @db.VarChar(500)
  image       String   @db.Text

  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt     @db.Timestamp(6)
}

model Galley{
  id        Int      @id @default(autoincrement())
  image     String   @db.Text
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt     @db.Timestamp(6)
}

model DistinguishedAlumni {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  batch       String   @db.VarChar(100)
  photo       String?  @db.Text
  achievement String   @db.VarChar(500)
  department  String?  @db.VarChar(255)
  linkedIn    String?  @db.VarChar(255)

  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt     @db.Timestamp(6)
}